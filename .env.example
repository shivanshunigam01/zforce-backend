NODE_ENV=development
PORT=4000

# MongoDB: local dev OR Atlas SRV string.
# Atlas: add your current public IP (or 0.0.0.0/0 for dev only) under
# Network Access → IP Access List, or connections fail with ReplicaSetNoPrimary / timeout.
MONGODB_URI=mongodb://127.0.0.1:27017/zforce
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
PAN_ENCRYPTION_SECRET=change_me_32_char_secret_key!!

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CIBIL_FEE_PAISE=7900

# Surepass — Experian credit report (after successful Razorpay payment)
# https://surepass.io — JWT in dashboard
SUREPASS_BASE_URL=https://kyc-api.surepass.io
SUREPASS_TOKEN=

CORS_ORIGINS=http://localhost:8080
PUBLIC_STOREFRONT_DEFAULT_SLUG=hq

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
