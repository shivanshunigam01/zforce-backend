NODE_ENV=development
PORT=4000

# MongoDB: local dev OR Atlas SRV string.
# Atlas: add your current public IP (or 0.0.0.0/0 for dev only) under
# Network Access → IP Access List, or connections fail with ReplicaSetNoPrimary / timeout.
MONGODB_URI=mongodb://127.0.0.1:27017/zforce
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
PAN_ENCRYPTION_SECRET=change_me_32_char_secret_key!!

# Default CIBIL fee (₹79) — overridden per storefront in Admin → CIBIL payment setup
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CIBIL_FEE_PAISE=7900

# Surepass — Experian credit report PDF + score (after successful Razorpay payment)
SUREPASS_BASE_URL=https://kyc-api.surepass.io
SUREPASS_TOKEN=

# Used when reverting app.ts from temporary open CORS to allowlist-only mode
CORS_ORIGINS=http://localhost:8080,https://zforceev.com,https://www.zforceev.com,https://admin.zforceev.com
# Must match a storefront in MongoDB (seed creates `patna-auto` and `hq`).
PUBLIC_STOREFRONT_DEFAULT_SLUG=patna-auto

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=adasdd
CLOUDINARY_API_SECRET=
